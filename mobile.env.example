# Mobile (Expo) environment variables — copy this to .env and fill in real values.
# Never commit the actual .env file.
# Note: Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app bundle.

# Backend API base URL — use your computer's LAN IP, not localhost,
# so your phone (running Expo Go) can reach it. Example: http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
