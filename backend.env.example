# Backend environment variables — copy this to .env and fill in real values.
# Never commit the actual .env file.

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financial_tracker
# For local SQLite instead: sqlite+aiosqlite:///./dev.db

# Auth / JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OCR provider (see agents.md §2 for the current chosen provider)
OCR_PROVIDER=google_cloud_vision
OCR_API_KEY=replace-with-your-ocr-api-key

# Image storage
STORAGE_BACKEND=local
# local | s3
STORAGE_LOCAL_PATH=./uploads
# If using S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# Push notifications
EXPO_ACCESS_TOKEN=replace-with-expo-push-access-token

# App
ENVIRONMENT=development
# development | staging | production
