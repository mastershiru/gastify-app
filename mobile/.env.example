# Gastify FastAPI base URL.
#
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8001
#
# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8001
#
# Physical device:
# Replace <YOUR-PC-LAN-IP> with the development computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://<YOUR-PC-LAN-IP>:8001

EXPO_PUBLIC_API_URL=http://10.0.2.2:8001
